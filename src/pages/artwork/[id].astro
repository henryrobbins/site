---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import ExhibitionCell from "@components/ExhibitionCell.astro";
import LinkGroup from "@components/LinkGroup.astro";
import SectionLabel from "@components/SectionLabel.astro";
import { responsiveWidths } from "@/utils/images";

export async function getStaticPaths() {
  const artwork = await getCollection("artwork");
  return artwork.map((art) => ({
    params: { id: art.data.id },
    props: { art },
  }));
}

const { art } = Astro.props;
const { title, artist, date, medium, link, physical, images, videos } = art.data;
const { Content } = await render(art);

const exhibitions = (await getCollection("exhibitions")).filter((exhibition) =>
  exhibition.data.featured.some((item) => item.id === art.id),
);

const year = date.getUTCFullYear();

// A plate is the content column inset by the frame's padding: 768px at the
// widest breakpoint.
const PLATE_WIDTHS = [768, 1536];
const PLATE_SIZES = "(max-width: 899px) calc(100vw - 40px), 768px";
---

<Layout
  title={title}
  description={`${title} (${year}) — ${medium}`}
  active="art"
  sub={title}
>
  <div class="detail-head">
    <div class="detail-kicker">Artwork</div>
    <h1 class="detail-title">{title}</h1>
    <div class="detail-meta">
      {artist}<br />
      {year} · {medium}
    </div>
    {link && <LinkGroup links={[{ href: link, label: "source code" }]} />}
  </div>

  {
    art.body?.trim() && (
      <div class="detail-body prose">
        <Content />
      </div>
    )
  }

  {
    exhibitions.length > 0 && (
      <>
        <SectionLabel label="Exhibitions" />
        <div class="exhibition-grid">
          {exhibitions.map((exhibition) => (
            <ExhibitionCell exhibition={exhibition} />
          ))}
        </div>
      </>
    )
  }

  <SectionLabel label="Work" />

  {
    physical &&
      Object.entries(physical).map(([name, work]) => (
        <figure class="plate">
          <div class="plate-frame">
            <Image
              src={work.path}
              alt={name}
              class="plate-img"
              {...responsiveWidths(work.path, PLATE_WIDTHS)}
              sizes={PLATE_SIZES}
              quality={90}
              loading="lazy"
            />
          </div>
          <figcaption class="plate-cap">
            <span>{name}</span>
            <span class="meta">
              {work.dimension} · {year}
            </span>
          </figcaption>
        </figure>
      ))
  }

  {
    images &&
      Object.entries(images).map(([name, src]) => (
        <figure class="plate">
          <div class="plate-frame">
            <Image
              src={src}
              alt={name}
              class="plate-img"
              {...responsiveWidths(src, PLATE_WIDTHS)}
              sizes={PLATE_SIZES}
              quality={90}
              loading="lazy"
            />
          </div>
          <figcaption class="plate-cap">
            <span>{name}</span>
            <span class="meta">{year}</span>
          </figcaption>
        </figure>
      ))
  }

  {
    videos &&
      Object.entries(videos).map(([name, vimeoId]) => (
        <figure class="plate">
          <div class="plate-frame">
            <div class="video-frame">
              <iframe
                src={`https://player.vimeo.com/video/${vimeoId}?badge=0&autopause=0&player_id=0&app_id=58479`}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                title={name}
              />
            </div>
          </div>
          <figcaption class="plate-cap">
            <span>{name}</span>
            <span class="meta">{year}</span>
          </figcaption>
        </figure>
      ))
  }
</Layout>
