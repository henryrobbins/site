---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { coverWidths } from "@/utils/images";

interface Props {
  artwork: CollectionEntry<"artwork">;
  /** Width of the square cell at the widest breakpoint, in CSS pixels. */
  box: number;
}

const { artwork, box } = Astro.props;
const { thumbnail, title, date } = artwork.data;
---

<a class="art-cell" href={`/artwork/${artwork.data.id}`}>
  {
    thumbnail ? (
      <Image
        src={thumbnail}
        alt={title}
        class="art-img grey"
        {...coverWidths(thumbnail, box)}
        quality={90}
        loading="lazy"
      />
    ) : (
      /* Pieces that exist only as video have no representative still yet; the
         cell holds its place in the sheet with an empty square. */
      <div class="art-img" />
    )
  }
  <div class="art-cap">
    <span class="title">{title}</span>
    <span class="year">{date.getUTCFullYear()}</span>
  </div>
</a>
