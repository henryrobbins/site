---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { responsiveWidths } from "@/utils/images";

interface Props {
  exhibition: CollectionEntry<"exhibitions">;
}

const { exhibition } = Astro.props;
const { id, name, year, city, thumbnail } = exhibition.data;
---

<a class="exhibition-cell" href={`/exhibitions/${id}`}>
  <Image
    src={thumbnail}
    alt={name}
    class="exhibition-img grey"
    {...responsiveWidths(thumbnail, [390, 780])}
    sizes="(max-width: 899px) 100vw, 288px"
    quality={90}
    loading="lazy"
  />
  <div class="exhibition-cap">
    <div class="name">{name}</div>
    <div class="where">{year} · {city}</div>
  </div>
</a>
