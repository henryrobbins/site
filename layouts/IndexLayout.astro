---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.jpeg";
import Layout from "./Layout.astro";
import ArtCell from "@components/ArtCell.astro";
import ContactLinks from "@components/ContactLinks.astro";
import SectionLabel from "@components/SectionLabel.astro";
import WorkRow from "@components/WorkRow.astro";
import { primaryHref, projectLinks, researchLinks } from "@/utils/links";
import { responsiveWidths } from "@/utils/images";

// The index is a curated view: entries opt in with `selected: true` in their
// front matter, and are shown newest first.
const byDate = <T extends { data: { date: Date } }>(a: T, b: T) =>
  b.data.date.getTime() - a.data.date.getTime();

const selected = (collection: "projects" | "research" | "artwork") =>
  getCollection(collection, ({ data }) => data.selected);

const work = [
  ...(await selected("projects")).map((entry) => ({
    entry,
    links: projectLinks(entry.data),
  })),
  ...(await selected("research")).map((entry) => ({
    entry,
    // The link column is one line wide. Projects fit `github · site`; for a
    // paper the one link worth keeping is the paper itself.
    links: researchLinks(entry.data).slice(0, 1),
  })),
]
  .sort((a, b) => byDate(a.entry, b.entry))
  .map(({ entry, links }) => ({
    year: entry.data.date.getUTCFullYear(),
    name: entry.data.name,
    description: entry.data.description,
    href: primaryHref(entry.data),
    links,
  }));

const images = (await selected("artwork")).sort(byDate);
---

<Layout title="Henry Robbins" description="An overview of my work and interests" active="home">
  <div class="bio prose">
    <Image
      src={profileImage}
      alt="Henry Robbins"
      class="bio-photo"
      {...responsiveWidths(profileImage, [264, 528])}
      sizes="176px"
      quality={90}
      loading="eager"
      fetchpriority="high"
    />
    <slot />
  </div>

  <ContactLinks class="contact-inline" />

  <SectionLabel
    label="Selected work"
    action={{ href: "/projects", label: "all projects", mobileLabel: "all" }}
    wide
  />
  {work.map((entry) => <WorkRow {...entry} />)}

  <SectionLabel
    label="Selected images"
    action={{ href: "/artwork", label: "all art", mobileLabel: "all" }}
    wide
  />
  <div class="art-grid is-three">
    {images.map((entry) => <ArtCell artwork={entry} box={288} />)}
  </div>
</Layout>

<style>
  .bio {
    padding: 44px var(--pad-wide) 40px;
    border-bottom: 1px solid var(--line);
  }

  /* The photo sits in the text itself, set flush with the left margin. */
  .bio-photo {
    float: left;
    width: 176px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    margin: 6px 22px 14px 0;
  }

  .bio > .bio-photo + :global(*) {
    margin-top: 0;
  }

  @media (max-width: 899px) {
    .bio {
      padding: 22px 20px 24px;
    }

    .bio-photo {
      width: 132px;
      margin: 4px 16px 12px 0;
    }
  }
</style>
