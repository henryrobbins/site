---
import { getCollection, getEntries, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import LinkGroup from "@components/LinkGroup.astro";
import ProjectCell from "@components/ProjectCell.astro";
import SectionLabel from "@components/SectionLabel.astro";

export async function getStaticPaths() {
  const experiences = await getCollection("experiences");
  return experiences.map((experience) => ({
    params: { id: experience.data.id },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const { name, role, company, start, end, github, github_link } =
  experience.data;
const { Content } = await render(experience);

const projects = await getEntries(experience.data.projects ?? []);

const month = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Layout
  title={name}
  description={`${role}, ${company}`}
  active="experience"
  sub={name}
>
  <div class="detail-head">
    <div class="detail-kicker">Experience</div>
    <h1 class="detail-title">{name}</h1>
    <div class="detail-meta">
      {role} · {company}<br />
      {month(start)} – {month(end)}
    </div>
    {
      github_link && (
        <LinkGroup links={[{ href: github_link, label: github ?? "github" }]} />
      )
    }
  </div>

  {
    experience.body?.trim() && (
      <div class="detail-body prose">
        <Content />
      </div>
    )
  }

  {
    projects.length > 0 && (
      <>
        <SectionLabel label="Projects" />
        <div class="cell-grid">
          {projects.map((project) => (
            <ProjectCell project={project} />
          ))}
        </div>
      </>
    )
  }
</Layout>
