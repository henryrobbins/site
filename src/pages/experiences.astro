---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ExperienceRow from "@components/ExperienceRow.astro";
import SectionLabel from "@components/SectionLabel.astro";

const experiences = (await getCollection("experiences")).sort(
  (a, b) =>
    b.data.end.getTime() - a.data.end.getTime() || b.id.localeCompare(a.id),
);
---

<Layout
  title="Experience"
  description="Professional experience of Henry Robbins."
  active="experience"
>
  <SectionLabel label="Experience" />
  {
    experiences.map((experience) => <ExperienceRow experience={experience} />)
  }
</Layout>
