---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ResearchRow from "@components/ResearchRow.astro";
import SectionLabel from "@components/SectionLabel.astro";

const research = (await getCollection("research")).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
);
---

<Layout
  title="Research"
  description="Research by Henry Robbins."
  active="research"
>
  <SectionLabel label="Research" />
  {research.map((entry) => <ResearchRow research={entry} />)}
</Layout>
