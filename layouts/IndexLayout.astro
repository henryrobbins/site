---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.jpeg";
import Layout from "./Layout.astro";
import ArtCell from "@components/ArtCell.astro";
import ContactLinks from "@components/ContactLinks.astro";
import SectionLabel from "@components/SectionLabel.astro";
import WorkRow from "@components/WorkRow.astro";
import { selectedArtwork, selectedWork } from "@/selected";
import { primaryHref, projectLinks, researchLinks } from "@/utils/links";
import { responsiveWidths } from "@/utils/images";

const projects = await getCollection("projects");
const research = await getCollection("research");
const artwork = await getCollection("artwork");

const work = selectedWork.map(({ collection, id }) => {
  const entries = collection === "projects" ? projects : research;
  const entry = entries.find((e) => e.id === id);
  if (!entry) throw new Error(`selectedWork references unknown entry: ${id}`);
  return {
    year: entry.data.date.getUTCFullYear(),
    name: entry.data.name,
    description: entry.data.description,
    href: primaryHref(entry.data),
    // The link column is one line wide. Projects fit `github · site`; for a
    // paper the one link worth keeping is the paper itself.
    links:
      collection === "projects"
        ? projectLinks(entry.data)
        : researchLinks(entry.data).slice(0, 1),
  };
});

const images = selectedArtwork.map((id) => {
  const entry = artwork.find((a) => a.id === id);
  if (!entry) throw new Error(`selectedArtwork references unknown entry: ${id}`);
  return entry;
});
---

<Layout
  title="Henry Robbins"
  description="An overview of my work and interests"
  active="home"
  profile
>
  <div class="bio prose">
    <Image
      src={profileImage}
      alt="Henry Robbins"
      class="bio-photo"
      {...responsiveWidths(profileImage, [264, 528])}
      sizes="264px"
      quality={90}
      loading="eager"
    />
    <slot />
  </div>

  <ContactLinks class="contact-inline" />

  <SectionLabel
    label="Selected work"
    action={{ href: "/projects", label: "all projects", mobileLabel: "all" }}
    rule="hair"
    wide
  />
  {work.map((entry) => <WorkRow {...entry} />)}

  <SectionLabel
    label="Selected images"
    action={{ href: "/artwork", label: "all art", mobileLabel: "all" }}
    rule="line"
    top
    wide
  />
  <div class="art-grid is-three">
    {images.map((entry) => <ArtCell artwork={entry} box={288} />)}
  </div>
</Layout>

<style>
  .bio {
    padding: 44px var(--pad-wide) 40px;
    border-bottom: 1px solid var(--line);
  }

  /* The rail carries the photo on desktop; on mobile it sits in the bio, with
     the opening paragraph set beside it. */
  .bio-photo {
    display: none;
  }

  .bio > .bio-photo + :global(*) {
    margin-top: 0;
  }

  @media (max-width: 899px) {
    .bio {
      padding: 22px 20px 24px;
    }

    .bio-photo {
      display: block;
      float: left;
      width: 132px;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      filter: grayscale(1) contrast(1.05);
      margin: 4px 16px 12px 0;
    }
  }
</style>
