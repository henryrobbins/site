---
import { getCollection, getEntries, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import ArtCell from "@components/ArtCell.astro";
import SectionLabel from "@components/SectionLabel.astro";
import { coverWidths, responsiveWidths } from "@/utils/images";

export async function getStaticPaths() {
  const exhibitions = await getCollection("exhibitions");
  return exhibitions.map((exhibition) => ({
    params: { id: exhibition.data.id },
    props: { exhibition },
  }));
}

const { exhibition } = Astro.props;
const { name, year, venue, city, posters, work } = exhibition.data;
const { Content } = await render(exhibition);

const featured = await getEntries(exhibition.data.featured);
---

<Layout
  title={name}
  description={`${name} — ${venue}, ${city}`}
  active="art"
  sub={name}
>
  <div class="detail-head">
    <div class="detail-kicker">Exhibition</div>
    <h1 class="detail-title">{name}</h1>
    <div class="detail-meta">
      {year}<br />
      {venue} · {city}
    </div>
  </div>

  {
    exhibition.body?.trim() && (
      <div class="detail-body prose">
        <Content />
      </div>
    )
  }

  {
    featured.length > 0 && (
      <>
        <SectionLabel label="Featured work" />
        <div class="art-grid is-three">
          {featured.map((artwork) => (
            <ArtCell artwork={artwork} box={288} />
          ))}
        </div>
      </>
    )
  }

  {
    posters.length > 0 && (
      <>
        <SectionLabel label="Posters" />
        <div class="poster-grid">
          {posters.map((src) => (
            <div class="poster">
              <Image
                src={src}
                alt={`${name} poster`}
                {...responsiveWidths(src, [400, 800])}
                sizes="400px"
                quality={90}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    work.length > 0 && (
      <>
        <SectionLabel label="Images" />
        <div class="art-grid is-three">
          {work.map((src) => (
            <div class="art-cell">
              <Image
                src={src}
                alt={`${name} installation`}
                class="art-img"
                {...coverWidths(src, 288)}
                quality={90}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </>
    )
  }
</Layout>

<style>
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .poster {
    border-right: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    padding: 20px;
    display: flex;
    justify-content: center;
  }

  .poster :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 520px;
  }

  @media (max-width: 899px) {
    .poster-grid {
      grid-template-columns: 1fr;
    }

    .poster {
      border-right: 0;
    }
  }
</style>
