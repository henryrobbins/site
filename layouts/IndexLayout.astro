---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.jpeg";
import Layout from "./Layout.astro";
import ArtCell from "@components/ArtCell.astro";
import ContactLinks from "@components/ContactLinks.astro";
import ProjectCell from "@components/ProjectCell.astro";
import ResearchRow from "@components/ResearchRow.astro";
import SectionLabel from "@components/SectionLabel.astro";
import { responsiveWidths } from "@/utils/images";

// The index is a curated view: entries opt in with `selected: true` in their
// front matter, and are shown newest first.
const byDate = <T extends { data: { date: Date } }>(a: T, b: T) =>
  b.data.date.getTime() - a.data.date.getTime();

const selected = async (collection: "projects" | "research" | "artwork") =>
  (await getCollection(collection, ({ data }) => data.selected)).sort(byDate);

const research = await selected("research");
const projects = await selected("projects");
const images = await selected("artwork");
---

<Layout title="Henry Robbins" description="An overview of my work and interests" active="home">
  <div class="bio">
    <Image
      src={profileImage}
      alt="Henry Robbins"
      class="bio-photo"
      {...responsiveWidths(profileImage, [264, 528])}
      sizes="(max-width: 899px) 176px, 200px"
      quality={90}
      loading="eager"
      fetchpriority="high"
    />
    <div class="bio-text prose"><slot /></div>
  </div>

  <ContactLinks class="contact-inline" />

  <SectionLabel label="Selected work" />
  {research.map((entry) => <ResearchRow research={entry} />)}

  <div class="cell-grid">
    {projects.map((project) => <ProjectCell project={project} />)}
  </div>

  <div class="art-grid">
    {images.map((entry) => <ArtCell artwork={entry} box={216} />)}
  </div>
</Layout>

<style>
  /* The photo and the text are columns: the text is set beside the photo
     rather than wrapping beneath it, and centered against it. */
  .bio {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 44px var(--pad-wide) 40px;
    border-bottom: 1px solid var(--line);
  }

  .bio-photo {
    flex: none;
    width: 200px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  /* Set a step below the shared prose size, to sit closer to the 14 to 15px
     type used by the rows, cells, and captions further down the page. */
  .bio-text {
    min-width: 0;
    font-size: 15.5px;
    line-height: 1.7;
  }

  @media (max-width: 899px) {
    .bio {
      flex-direction: column;
      gap: 20px;
      padding: 24px 20px 26px;
      border-bottom: 0;
    }

    .bio-photo {
      width: 176px;
      align-self: center;
    }

    .bio-text {
      font-size: 15px;
    }
  }
</style>
