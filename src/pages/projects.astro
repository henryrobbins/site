---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCell from "@components/ProjectCell.astro";
import SectionLabel from "@components/SectionLabel.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
);
---

<Layout
  title="Projects"
  description="Open-source projects by Henry Robbins."
  active="projects"
>
  <SectionLabel label="Projects" />
  <div class="cell-grid">
    {projects.map((project) => <ProjectCell project={project} />)}
  </div>
</Layout>
