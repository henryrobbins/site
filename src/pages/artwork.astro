---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArtCell from "@components/ArtCell.astro";
import ExhibitionCell from "@components/ExhibitionCell.astro";
import SectionLabel from "@components/SectionLabel.astro";

const exhibitions = (await getCollection("exhibitions")).sort(
  (a, b) => b.data.year - a.data.year || b.id.localeCompare(a.id),
);

// The contact sheet shows one representative image per artwork, so pieces that
// exist only as video are left out.
const artwork = (await getCollection("artwork"))
  .filter((entry) => entry.data.thumbnail)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
  );
---

<Layout
  title="Art"
  description="Exhibitions and artwork by Henry Robbins."
  active="art"
>
  <SectionLabel label="Exhibitions" />
  <div class="exhibition-grid">
    {
      exhibitions.map((exhibition) => (
        <ExhibitionCell exhibition={exhibition} />
      ))
    }
  </div>

  <SectionLabel label="Work" />
  <div class="art-grid">
    {artwork.map((entry) => <ArtCell artwork={entry} box={216} />)}
  </div>
</Layout>
